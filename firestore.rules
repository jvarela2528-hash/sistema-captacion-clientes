rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función global: Verifica si el usuario inició sesión
    function isAuthenticated() {
      return request.auth != null;
    }

    // Colección de Prospectos (Leads)
    match /leads/{leadId} {
      // Permite que cualquiera envíe el formulario web de captación
      allow create: if true; 
      
      // Solo tú o tus usuarios autenticados pueden ver, editar o borrar leads
      allow read, update, delete: if isAuthenticated();
    }

    // Colección de Usuarios Internos (Protegida por su propio UID)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regla de Cierre Segura: Deniega cualquier acceso a colecciones no especificadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}